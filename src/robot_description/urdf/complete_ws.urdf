    </plugin>
    <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_rg2_gripper_left_inner_finger_joint">
      <joint>rg2_gripper_finger_joint</joint>
      <mimicJoint>rg2_gripper_left_inner_finger_joint_mimic</mimicJoint>

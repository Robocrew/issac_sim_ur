      <offset>0.0</offset>
      <maxEffort>5.0</maxEffort>
    </plugin>
    <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_rg2_gripper_right_inner_finger_joint">

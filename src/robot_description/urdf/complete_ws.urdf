      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00032883580596562505" ixy="0.0" ixz="0.0" iyy="0.00032883580596562505" iyz="0.0" izz="0.0006002500000000001"/>

    <parent link="rg2_gripper_base_link"/>
    <child link="ur10e_nozzle_for_tape"/>
    <origin rpy="1.57 0 -1.57" xyz="0.02 0 0.196"/>
  </joint>
  <link name="tcp_nozzle_tip">
    <visual name="tape_pointer">
      <!-- The tape starts at the nozzle tip and extends along TCP +Z. -->
      <origin rpy="0 0 0" xyz="0 0 0.13"/>
      <geometry>
        <box size="0.001 0.003 0.26"/>
      </geometry>
      <material name="tape_yellow">
        <color rgba="0.9 0.8 0.05 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="tcp_nozzle_tip_joint" type="fixed">
    <parent link="ur10e_nozzle_for_tape"/>
    <child link="tcp_nozzle_tip"/>
    <origin rpy="0 1.5708 1.5708" xyz="0 0.04885 0.035"/>
  </joint>
  <!-- <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <robotNamespace>/onrobot_rg2</robotNamespace>
        <robotSimType>gazebo_ros2_control/DefaultRobotHWSim</robotSimType>
      </plugin> 
    </gazebo>

    <xacro:if value="${sim_gazebo}">
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </xacro:if> -->
  <gazebo>
    <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_rg2_gripper_left_inner_knuckle_joint">
      <joint>rg2_gripper_finger_joint</joint>
      <mimicJoint>rg2_gripper_left_inner_knuckle_joint_mimic</mimicJoint>
      <multiplier>-1.0</multiplier>
      <offset>0.0</offset>
      <maxEffort>5.0</maxEffort>
    </plugin>
    <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_rg2_gripper_right_inner_knuckle_joint">

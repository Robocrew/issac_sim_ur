    <parent link="camera_link"/>
    <child link="camera_accel_frame"/>
  </joint>
  <joint name="camera_accel_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_accel_frame"/>
    <child link="camera_accel_optical_frame"/>
  </joint>
  <joint name="camera_gyro_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.01174 -0.00552 0.0051"/>
    <parent link="camera_link"/>
    <child link="camera_gyro_frame"/>
  </joint>
  <joint name="camera_gyro_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_gyro_frame"/>
    <child link="camera_gyro_optical_frame"/>
  </joint>
  <!-- Use a dedicated simulation link because Gazebo Classic drops sensor
         extensions while reducing the fixed-frame chain in the RealSense
         description. Preserve a direct joint from the requested parent; the
         sensor pose below supplies the D435 depth-optical-frame offset. -->
  <link name="camera_gazebo_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="camera_gazebo_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_mount_link"/>
    <child link="camera_gazebo_link"/>
  </joint>
  <gazebo reference="camera_gazebo_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="camera_gazebo_link">
    <sensor name="camera_d435i" type="depth">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <pose>0.0106 0.0175 0.0125 -1.5707963267948966 0 -1.5707963267948966</pose>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="camera_controller">
        <ros/>
        <camera_name>camera</camera_name>
        <frame_name>camera_depth_optical_frame</frame_name>
        <hack_baseline>0.07</hack_baseline>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
  <!-- Gazebo plugins -->
  <gazebo reference="world">
    </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">

  <link name="slot_tcp"/>
  <joint name="tool_mount_to_slot_tcp" type="fixed">
    <!-- Keep the TCP used by MoveIt/Servo exactly at the physical tape outlet.
         The previous tool-mount offset was parallel to, but displaced from,
         tcp_nozzle_tip and put the tape about 15 mm above the coil slot. -->
    <parent link="tcp_nozzle_tip"/>
    <child link="slot_tcp"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
</robot>

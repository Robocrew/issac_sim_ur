  </joint>
  <joint name="fts_joint" type="fixed">
    <!-- The parent link must be read from the robot model it is attached to. -->
    <parent link="adapter_plate_socket"/>
    <child link="fts_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="fts_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/on_robot_ft/onrobot_hexe_v2_ft_sensor.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>

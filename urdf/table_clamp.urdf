<?xml version="1.0"?>
<robot name="table_clamp">
  <material name="clamp_white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="clamp_grey">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="coil_copper">
    <color rgba="0.72 0.45 0.2 1"/>
  </material>

  <link name="world"/>
  <link name="table_clamp_mount_link"/>
  <joint name="table_clamp_mount_joint" type="fixed">
    <origin rpy="1.57 0 0" xyz="0.445 1.104 0.9281"/>
    <parent link="world"/>
    <child link="table_clamp_mount_link"/>
  </joint>

  <link name="clamp_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/stator_clamp/clamp.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="clamp_white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/stator_clamp/clamp.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="50.0"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
  </link>
  <joint name="clamp_fixed_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="table_clamp_mount_link"/>
    <child link="clamp_link"/>
  </joint>

  <link name="clamp_stator_mount_link"/>
  <joint name="clamp_stator_mount_joint" type="continuous">
    <origin rpy="0 1.57079632679 0" xyz="0.28 0.34 0.20"/>
    <parent link="clamp_link"/>
    <child link="clamp_stator_mount_link"/>
    <axis xyz="1 0 0"/>
    <limit effort="50.0" velocity="1.57"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="stator_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/stator_clamp/stator.dae" scale="1 1 1"/>
      </geometry>
      <material name="clamp_white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/stator_clamp/stator.dae" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
  </link>
  <joint name="stator_fixed_joint" type="fixed">
    <parent link="clamp_stator_mount_link"/>
    <child link="stator_link"/>
  </joint>

  <link name="clamp_vorderteil_link">
    <visual>
      <origin rpy="0 0 3.14159265359" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Clamp_Vorderteil/ClampVorderteil.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="clamp_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 3.14159265359" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Clamp_Vorderteil/ClampVorderteil.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="clamp_vorderteil_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.015 0 0"/>
    <parent link="stator_link"/>
    <child link="clamp_vorderteil_link"/>
  </joint>

  <link name="zwischenteil_clamp_link">
    <visual>
      <origin rpy="0 1.57079632679 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/ZwischenteilClampVorderteilUndCoil.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="clamp_grey"/>
    </visual>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/ZwischenteilClampVorderteilUndCoil.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="zwischenteil_clamp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.105 0 0"/>
    <parent link="clamp_vorderteil_link"/>
    <child link="zwischenteil_clamp_link"/>
  </joint>

  <link name="virtual_coil_link_marcus">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Coil.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="coil_copper"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Coil.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="stator_coil_mount_joint" type="fixed">
    <origin rpy="-1.57079632679 1.57079632679 0" xyz="-0.1305 0 0"/>
    <parent link="zwischenteil_clamp_link"/>
    <child link="virtual_coil_link_marcus"/>
  </joint>

  <ros2_control name="table_clamp_system" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="clamp_stator_mount_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
